{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Auto Build and Run",
            "command": "gcc",
            "args": [
                "git_second.c",
                "-o",
                "MyWinApp.exe",
                "-Wl,--subsystem,windows",
                "&&",
                ".\\MyWinApp.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}

